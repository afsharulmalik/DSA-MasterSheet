class Solution {
    public String makeFancyString(String s) {
        int n = s.length();
        if(n<3) return s;
        StringBuilder str = new StringBuilder();
        str.append(s.charAt(0));
        str.append(s.charAt(1));
        for(int i=2; i<n; i++){
            int len = str.length();
            if(s.charAt(i) != str.charAt(len-1) || s.charAt(i) != str.charAt(len-2)){
                str.append(s.charAt(i));
            }
        }
        return str.toString();
    }
}


