class Solution {
    public String longestCommonPrefix(String[] str) {
        Arrays.sort(str);
        // Lexicographical sorting mein agar kisi prefix ko saari strings mein common hona hai, 
        // toh woh sorted array ki first aur last strings mein bhi common hona chahiye.
        String first = str[0];
        String last = str[str.length-1];
        int idx = 0;
        while(idx < first.length() && idx< last.length()){
            if(first.charAt(idx) == last.charAt(idx)){
                idx++;
            }else{
                break;
            }
        }
        return first.substring(0,idx);
    }
}



