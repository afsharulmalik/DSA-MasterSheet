class Solution {
    public static char getMaxOccuringChar(String s) {
        int[] freq = new int[26];
        for(int i=0; i<s.length(); i++){
            freq[s.charAt(i)-'a']++; 
            // for i =0 97-97
            // for i=1  98-97
            // for i=3  99-97
        }
        int maxFreq =0;
        char ans = s.charAt(0);
        for(int i=0; i<s.length(); i++){
            char ch = s.charAt(i);
            // if(freq[ch-'a']>maxFreq){
            //     maxFreq = freq[ch-'a'];
            //     ans = ch;
            // }
            if (freq[ch - 'a'] > maxFreq ||
                (freq[ch - 'a'] == maxFreq && ch < ans)) {
                maxFreq = freq[ch - 'a'];
                ans = ch;
            }
        }
        return ans;
    }
}


