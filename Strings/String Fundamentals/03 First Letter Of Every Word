class Solution {
    String firstAlphabet(String s) {
        StringBuilder str = new StringBuilder();
        str.append(s.charAt(0));
        for(int i=1; i<s.length(); i++){
            if(s.charAt(i)==' '){
                str.append(s.charAt(i+1));
            }
        }
        return str.toString();
    }
}


