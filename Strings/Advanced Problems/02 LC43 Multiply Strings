class Solution {
    public String multiply(String num1, String num2) {
        if(num1.equals("0") || num2.equals("0")) return "0"; // edge case
        int m = num1.length();
        int n = num2.length();
        int[] result = new int[m+n]; // maximum length of the final can be sum of length of both the strings
        // num1 = 99, m=2    num2 = 99, n=2      result = 9801, length = 4
        for(int i=m-1; i>=0; i--){
            int digit1 = num1.charAt(i)-'0';
            for(int j=n-1; j>=0; j--){
                int digit2 = num2.charAt(j)-'0';
                int product = digit1 * digit2;
                int pos1 = i+j; // position for carry : tens place wala
                int pos2 = i+j+1; // position for remainder : ones place wala
                int sum = product + result[pos2];
                result[pos2] = sum % 10;
                result[pos1] += sum / 10;
            }
        }
        // coverting integer array to string
        StringBuilder sb = new StringBuilder();
        for(int ele : result) {
            if (!(sb.length() == 0 && ele == 0)) {
                sb.append(ele);
            }
        }
        return sb.toString();
    }
}



