// merge sort
// this question is reliable for merge sort not for quick sort 
class Solution{
    // helper function 2
    public void merge(int[] nums, int low, int mid, int high){
        int[] temp = new int[high-low+1];
        int left = low;
        int right = mid+1;
        int idx = 0;
        while(left<=mid && right <=high){
            if (nums[left]<=nums[right]){
                temp[idx++]= nums[left++];
            } else{
                temp[idx++]= nums[right++];
            }
        }
        while(left<=mid){
            temp[idx++]=nums[left++];
        } 
        while(right <= high){
            temp[idx++]=nums[right++];
        }
        for(int i= low; i<=high; i++) {
            nums[i] = temp[i-low];
        }
    }
    // helper function 1
    public void mergeSort(int[] nums, int low, int high){
        if(low>=high) return;
        int mid = low +(high-low)/2;
        mergeSort(nums, low, mid); // ye left side se sorting perform karega 
        mergeSort(nums, mid+1, high); // ye right side se 
        merge(nums, low, mid, high);
    }
    // main function
    public int[] sortArray(int[] nums){
        mergeSort(nums, 0, nums.length-1);
        return nums;
    }
}

