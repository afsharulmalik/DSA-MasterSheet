class Solution {
    public double myPow(double x, int n) {
        if(n==0) return 1.0;
        double call = myPow(x,n/2);
        if(n%2==0) return call*call; // when n is positive and even
        else if (n>0) return x*call*call; // when n is odd
        else return (1/x)*call*call; // when n is negative
    }
}



