class Solution {
    static final long MOD = 1_000_000_007L;
    // helper function
    private long power(long x, long n) {
        if(n==0) return 1;
        long call = power(x,n/2);
        if(n%2!=0) return (x*(call*call) % MOD) % MOD;
        else return (call*call) % MOD;
    }
    // main function
    public int countGoodNumbers(long n) {
        long evenPositions = (n + 1) / 2;
        long oddPositions = n / 2;
        long evenWays = power(5, evenPositions); // 5 different combinations thats why 5
        long oddWays = power(4, oddPositions);  // 4 different combinations
        return (int) ((evenWays * oddWays) % MOD);
    }
}


/*
Kisi string ko good hone ke liye do conditions satisfy karni hongi:
- Even indices (0, 2, 4, ...): digit even honi chahiye — 0, 2, 4, 6, 8 yani 5 choices.
- Odd indices (1, 3, 5, ...): digit prime honi chahiye — 2, 3, 5, 7 yani 4 choices.


