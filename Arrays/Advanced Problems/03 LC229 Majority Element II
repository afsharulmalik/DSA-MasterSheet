class Solution {
    public List<Integer> majorityElement(int[] nums) {
        List<Integer> result = new ArrayList<>();
        int ans1 =0;
        int ans2 =0;
        int count1 =0;
        int count2 =0;
        int n = nums.length;
        for(int ele : nums){
            if(ele == ans1 && count1 > 0) count1++;
            else if(ele == ans2 && count2 > 0) count2++;
            else if(count1 == 0){
                ans1 = ele;
                count1 = 1;
            }else if(count2 == 0){
                ans2 = ele;
                count2 = 1;
            }else{
                count1--;
                count2--;
            }
        }
        count1 =0;
        count2 = 0;
        for(int ele : nums){
            if(ele == ans1) count1++;
            else if(ele == ans2) count2++;
        }
        if(count1 > n/3) result.add(ans1);
        if(count2 > n/3) result.add(ans2);
        return result;
    }
}


// // brute force
// any number appearing in the array, theirs count must be greater than the floor of n/3
// max number of elements in the ans list will be 2



