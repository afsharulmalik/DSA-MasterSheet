class Solution {
    public int maxValue(int arr[]) {
        
        // brute force
        // int n = arr.length;
        // int max = 0;
        // for(int i=0; i<n; i++){
        //     for(int j=i+1; j<n; j++){
        //         int val = Math.abs(arr[i]-arr[j]) + Math.abs(i-j);
        //         max = Math.max(max,val);
        //     }
        // }
        // return max;
        
        // Optimised approach
        int minSum = Integer.MAX_VALUE;
        int maxSum = Integer.MIN_VALUE;
        int minDiff = Integer.MAX_VALUE;
        int maxDiff = Integer.MIN_VALUE;
        int n = arr.length;
        for(int i=0; i<n; i++){
            // arr[i]+i
            maxSum = Math.max(maxSum,arr[i]+i);
            minSum = Math.min(minSum,arr[i]+i);
            
            // arr[i]-i
            maxDiff = Math.max(maxDiff,arr[i]-i);
            minDiff = Math.min(minDiff,arr[i]-i);
        }
        return Math.max(maxSum-minSum, maxDiff-minDiff);
    }
}



