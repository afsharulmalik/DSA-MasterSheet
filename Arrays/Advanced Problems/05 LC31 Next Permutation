class Solution {

    // helper function
    public void swap(int[] nums, int i, int j){
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;
    }

    // helper function
    public void reverse(int[] nums, int start, int end){
        while(start<end){
            swap(nums, start, end);
            start++;
            end--;
        }
    }

    // main function
    public void nextPermutation(int[] nums) {
        int n = nums.length;
        // find that blue gola index
        int blueIdx = -1;
        for(int i=n-1; i>0; i--){
            if(nums[i]>nums[i-1]){
                blueIdx = i-1;
                break;
            }
        }

        // finding idx to swap
        if(blueIdx != -1){
            int swapIdx = blueIdx;
            for(int i=n-1; i>=blueIdx+1; i--){
                if(nums[i]>nums[blueIdx]){
                    swapIdx = i;
                    break;
                }
            }
            swap(nums, blueIdx,swapIdx);
        }
        reverse(nums, blueIdx+1,n-1);   
    }
}


