class Solution {
    public void wiggleSort(int[] nums) {
        int n = nums.length;
        int[] arr = nums.clone();
        Arrays.sort(arr);
        int left = (n-1)/2; // end of smaller part
        int right = n-1; // end of larger part
        for(int i=0; i<n; i++){
            if(i%2==0){
                nums[i] = arr[left];
                left--;
            }else{
                nums[i] = arr[right];
                right--;
            }
        }
    }
}



