class Solution {
    public int getSecondLargest(int[] arr) {
        int n = arr.length;
        int max = Integer.MIN_VALUE;
        for(int i=0; i<n; i++){
            if(arr[i]>max) max = arr[i];
        }
        int smax = -1;
        for(int i=0; i<n; i++){
            if(arr[i]>smax && arr[i]!=max) smax = arr[i];
        }
        return smax;
    }
}


