class Solution {
    public static int findEquilibrium(int arr[]) {
        int n = arr.length;
        int totalSum = 0;
        int leftSum = 0;
        
        // totalSum nikal liye
        for(int i=0; i<n; i++){
            totalSum += arr[i];
        }
        
        // remaining Sum or right Sum
        for(int i=0; i<n; i++){
            totalSum -= arr[i];
            if(leftSum == totalSum) return i; // compare left and right sum
            leftSum += arr[i]; // add curr ele to left sum
        }
        return -1;
    }
}


