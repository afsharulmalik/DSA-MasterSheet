class Solution {
    public int[] rearrangeArray(int[] nums) {
        // Positive numbers ke liye pos = 0 aur negative numbers ke liye neg = 1 rakho. Har insertion ke baad index ko 2 se increment karo
        int n = nums.length;
        int[] ans = new int[n];
        int positive = 0;
        int negative = 1;
        for(int i=0; i<n; i++){
            if(nums[i]>0){
                ans[positive] = nums[i];
                positive+=2;
            }else{
                ans[negative] = nums[i];
                negative+=2;
            }
        }
        return ans;
    }
}


