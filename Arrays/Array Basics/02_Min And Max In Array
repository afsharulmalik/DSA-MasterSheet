class Solution {
    public ArrayList<Integer> getMinMax(int[] arr) {
        ArrayList<Integer> maxMin = new ArrayList<>();
        int n = arr.length;
        int min = Integer.MAX_VALUE;
        int max = Integer.MIN_VALUE;
        for(int i=0; i<n; i++){
            if(arr[i]>max){
                max = arr[i];
            }
            if(arr[i]<min){
                min = arr[i];
            }
        }
        maxMin.add(min);
        maxMin.add(max);
        return maxMin;
    }
}


