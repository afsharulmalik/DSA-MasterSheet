class Solution {
    public int[] findDiagonalOrder(int[][] mat) {
        int m = mat.length;
        int n = mat[0].length;
        int[] ans = new int[m*n];
        int row = 0; // 0th index par hai row
        int col = 0; // 0th index par hai col
        int direction = 1; // up-right

        for(int i=0; i<m*n; i++){
            ans[i] = mat[row][col];
            if(direction == 1){ // up-right
                if(col == n-1){ // col last par hai ab right nahi jaa skte isiliye next row mein neeche jaayenge aur direction reverse kar denge
                    row++;
                    direction = -1;
                }else if(row == 0){ // ab upar nahi jaa skte isiliye next col mein jaayenge aur direction reverse kar denge
                    col++;
                    direction = -1;
                }else{ // jab koi boundry nahi hai toh ek row upar aur ek col right move krte hai  
                    row--;
                    col++;
                }
            }else{ // down-left
                if(row == m-1){
                    col++;
                    direction = 1;
                }else if(col == 0){
                    row++;
                    direction = 1;
                }else{
                    row++;
                    col--;
                }
            }
        }
        return ans;
    }
}

/*
direction up-right -> 1 (row--,col++)
direction down-left -> -1 (row++,col--)
*/



