class Solution {
    public int diagonalSum(int[][] mat) {
        int m = mat.length;
        int sum = 0;
        for(int i=0; i<m; i++){
            sum += mat[i][i]; // top left to bottom right
            if(i != m-1-i) sum+=mat[i][m-1-i];
        }
        return sum;
    }
}


// Secondary Diagonal. For the same row i, the secondary diagonal element (top-right to bottom-left) is located at mat[i][n - 1 - i].


