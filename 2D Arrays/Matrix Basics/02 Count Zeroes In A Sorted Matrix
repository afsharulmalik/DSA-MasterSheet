class Solution {
    public int countZeros(int[][] mat) {
        int m = mat.length;
        int n = mat[0].length;
        int count = 0;
        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                if(mat[i][j]==0) count++;
                else j++;
            }
        }
        return count;
    }
};


